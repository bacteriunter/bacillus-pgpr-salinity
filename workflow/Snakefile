configfile: "config/config.yaml"

import glob
import os

PROTEOMES = glob.glob(config["proteomes_dir"] + "/*.faa")
GENOMES = [os.path.splitext(os.path.basename(f))[0] for f in PROTEOMES]

rule all:
    input:
        "05_pgpr_matrix/pgpr_presence_absence_matrix_complete.tsv",
        "05_pgpr_matrix/pgpr_matrix_with_metadata.tsv",
        "06_statistics/pgpr_frequencies_by_group.tsv",
        "06_statistics/fisher_pgpr_results.tsv",
        "06_statistics/pgpr_module_score_stats.tsv",
        "08_figures/fig3_heatmap/pgpr_presence_absence_heatmap.png",
        "08_figures/fig4_module_scores/pgpr_module_scores_boxplot.png",
        "08_figures/fig5_pcoa/pca_plot.png",
        "08_figures/fig1_workflow/workflow_comparative_genomics.png"

rule hmmsearch_pgpr:
    input:
        faa=lambda wildcards: f"{config['proteomes_dir']}/{wildcards.genome}.faa",
        hmm=config["hmm_db"]
    output:
        tbl=f"{config['hmmsearch_dir']}/{{genome}}.tbl",
        log=f"{config['hmmsearch_dir']}/{{genome}}.log"
    threads: config["threads_hmmsearch"]
    shell:
        """
        mkdir -p {config[hmmsearch_dir]}
        hmmsearch --cpu {threads} \
          --tblout {output.tbl} \
          {input.hmm} \
          {input.faa} \
          > {output.log}
        """

rule parse_hmmsearch:
    input:
        expand(f"{config['hmmsearch_dir']}/{{genome}}.tbl", genome=GENOMES)
    output:
        hits="04_functional_annotation/kofamscan/annotation_summary/pgpr_hits_filtered_all.tsv",
        matrix="05_pgpr_matrix/pgpr_presence_absence_matrix.tsv"
    shell:
        """
        python scripts/python/05_parse_all_pgpr_hmmsearch.py
        """

rule complete_matrix:
    input:
        matrix="05_pgpr_matrix/pgpr_presence_absence_matrix.tsv",
        kos=config["target_kos"]
    output:
        "05_pgpr_matrix/pgpr_presence_absence_matrix_complete.tsv"
    shell:
        """
        python scripts/python/16_complete_pgpr_matrix.py
        """

rule merge_metadata:
    input:
        matrix="05_pgpr_matrix/pgpr_presence_absence_matrix_complete.tsv",
        saline="00_metadata/saline_final.tsv",
        non_saline="00_metadata/non_saline_final.tsv"
    output:
        "05_pgpr_matrix/pgpr_matrix_with_metadata.tsv"
    shell:
        """
        python scripts/python/17_merge_pgpr_metadata.py
        """

rule frequencies:
